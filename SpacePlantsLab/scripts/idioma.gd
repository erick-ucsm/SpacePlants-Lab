func _enter_tree() -> void:
	_traduccion = Translation.new()
	_traduccion.locale = "en"
	for k in EN:
		_traduccion.add_message(k, EN[k])
	TranslationServer.add_translation(_traduccion)
	ProjectSettings.set_setting("internationalization/locale/fallback", "es")
	var cfg := ConfigFile.new()
	if cfg.load(RUTA) == OK:
		idioma = cfg.get_value("idioma", "codigo", "en")
	TranslationServer.set_locale(idioma)


func cambiar(codigo: String) -> void:
	if codigo == idioma or not IDIOMAS.has(codigo):
		return
	idioma = codigo
	TranslationServer.set_locale(idioma)
	var cfg := ConfigFile.new()
	cfg.set_value("idioma", "codigo", idioma)
	cfg.save(RUTA)
	idioma_cambiado.emit()


func t(texto: String) -> String:
	if idioma == "en":
		return EN.get(texto, texto)
	return texto


func traducir(valor: Variant) -> Variant:
	if valor is String:
		return t(valor)
	if valor is Dictionary:
		var d := {}
		for k in valor:
			d[k] = traducir(valor[k])
		return d
	if valor is Array:
		var a := []
		for x in valor:
			a.append(traducir(x))
		return a
	return valor

