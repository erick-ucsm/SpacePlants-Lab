[node name="TextoInstr" type="Label" parent="PanelInstrucciones/VBox" unique_id=2109735259]
layout_mode = 2
size_flags_vertical = 3
text = "1. Pasa el mouse sobre cada opción para leer qué hace y cómo afecta al juego.
2. Haz clic en una opción para elegirla: pasas al siguiente paso.
3. En cada categoría todas las opciones cumplen el mismo objetivo: compara cuál te conviene más.
4. Cuida la masa de lanzamiento: el cohete tiene un límite.
5. Cuanta más energía gasten tus componentes, más rápido se agotará la luz.
6. Al final revisa el resumen y lanza tu misión."
autowrap_mode = 3

[node name="BtnCerrarInstrucciones" type="Button" parent="PanelInstrucciones/VBox" unique_id=112549283]
unique_name_in_owner = true
layout_mode = 2
text = "Entendido"
